{
  "images": {
    "domains": [],
    "formats": [
      "image/avif",
      "image/webp"
    ]
  },
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}