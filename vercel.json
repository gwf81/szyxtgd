{
  "images": {
    "domains": [],
    "formats": ["image/avif", "image/webp"],
    "sizes": ["640w", "750w", "828w", "1080w", "1200w", "1920w"]
  },
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}